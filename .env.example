# 复制为 .env 后填入真实值。.env 已在 .gitignore 中，禁止提交。
# 课程红线：密钥与个人数据严禁进入仓库与提示词。

# 应用
APP_ENV=development
APP_PORT=8000
SECRET_KEY=change-me

# 数据库
DATABASE_URL=postgresql://user:password@localhost:5432/workspace

# 对象存储（资料上传）
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=workspace-files
S3_ACCESS_KEY=
S3_SECRET_KEY=

# 第三方登录（外部集成点）
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback
